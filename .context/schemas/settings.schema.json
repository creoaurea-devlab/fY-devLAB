{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CA_WISDOM settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "mode",
    "routing",
    "human_in_loop",
    "population",
    "self_healing"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/settings.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "autonomous",
        "human_in_loop"
      ]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_order",
        "route_roles",
        "role_flows"
      ],
      "properties": {
        "selection_order": {
          "const": [
            "explicit_role",
            "task_intent",
            "ownership",
            "fallback"
          ]
        },
        "route_roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "role_flows": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ARCHITECTURE",
                "CONVENTIONS",
                "INTEGRATIONS",
                "STATE",
                "STRUCTURE",
                "TESTING"
              ]
            }
          }
        }
      }
    },
    "human_in_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoints"
      ],
      "properties": {
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "before_write",
              "before_close"
            ]
          }
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "registry"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "on_demand",
            "manual"
          ]
        },
        "registry": {
          "const": ".wisdom/agents/agents.json"
        },
        "source_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "self_healing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_attempts"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
